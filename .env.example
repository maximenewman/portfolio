# ---- Database (Neon serverless Postgres) ----
# Neon dashboard → Connection string (pooled). Include ?sslmode=require.
DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ---- Blob storage (Tigris, S3-compatible) ----
# Run `fly storage create` in this project; it prints these values.
AWS_ACCESS_KEY_ID="tid_xxx"
AWS_SECRET_ACCESS_KEY="tsec_xxx"
AWS_ENDPOINT_URL_S3="https://fly.storage.tigris.dev"
AWS_REGION="auto"
# `fly storage create` sets this automatically (TIGRIS_BUCKET also accepted).
BUCKET_NAME="your-bucket-name"
# Public base for reading objects (bucket must be public-read).
# Defaults to https://<BUCKET_NAME>.fly.storage.tigris.dev if unset.
TIGRIS_PUBLIC_BASE="https://your-bucket-name.fly.storage.tigris.dev"

# ---- Auth (Clerk) ----
# Clerk dashboard → API keys.
# NOTE: NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is inlined into the bundle at BUILD
# time (like all NEXT_PUBLIC_* vars), so on Fly it must be passed as a Docker
# --build-arg (see fly-deploy.yml + the GitHub secret of the same name), NOT
# only as a runtime secret — a runtime-only value bakes in `undefined` and
# Clerk throws "Missing publishableKey". CLERK_SECRET_KEY is read server-side
# at runtime, so a Fly runtime secret is correct for it.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# Comma-separated Clerk user IDs allowed into /admin (yours). Find it in the
# Clerk dashboard → Users, or it's logged on first sign-in.
ADMIN_USER_IDS="user_xxx"
